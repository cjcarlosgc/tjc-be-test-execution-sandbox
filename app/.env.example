PORT=3000

# Bearer token required from RAG Core on every request (INTEROP-1.1 §3).
SANDBOX_SERVICE_TOKEN=

# Milliseconds suggested to Core before polling execution status again.
SANDBOX_POLL_AFTER_MS=2000

# --- 002-project-workspace / object-storage-access ---

# Comma-separated hostnames allowed for EphemeralDownloadRef URLs. Empty
# denies every download (fail closed) — required for real operation.
SANDBOX_ALLOWED_DOWNLOAD_HOSTS=

# Root directory for ephemeral per-execution workspaces (default: an OS temp
# subdirectory). Never accepted from a request.
SANDBOX_WORKSPACE_ROOT=

# TTL (ms) after which the sweeper reclaims an orphaned workspace directory.
SANDBOX_WORKSPACE_TTL_MS=1800000

# Download transport limits.
SANDBOX_DOWNLOAD_TIMEOUT_MS=15000
SANDBOX_DOWNLOAD_MAX_REDIRECTS=1
SANDBOX_DOWNLOAD_MAX_RETRIES=2
SANDBOX_MAX_DOWNLOAD_BYTES=209715200

# Safe-unzip limits (zip bomb / excessive archive defenses).
SANDBOX_MAX_ZIP_ENTRIES=20000
SANDBOX_MAX_UNCOMPRESSED_BYTES=524288000
SANDBOX_MAX_ENTRY_UNCOMPRESSED_BYTES=104857600
SANDBOX_MAX_COMPRESSION_RATIO=100

# --- 004-container-execution (Docker smoke execution only; install/compile/
# test commands remain PENDING behind DEC-SBX-002) ---

# Docker connects via dockerode, never the `docker` CLI. Leave both host/
# socket empty to use dockerode's own OS default (Docker Desktop socket).
SANDBOX_DOCKER_HOST=
SANDBOX_DOCKER_PORT=2375
SANDBOX_DOCKER_SOCKET_PATH=

# Node image/runtime is configurable, never a single fixed global version.
SANDBOX_DEFAULT_NODE_IMAGE=node:22-slim
SANDBOX_CONTAINER_USER=node

# Container resource limits (Sandbox policy; a request can never raise them).
SANDBOX_CONTAINER_MEMORY_BYTES=268435456
SANDBOX_CONTAINER_NANO_CPUS=1000000000
SANDBOX_CONTAINER_PIDS_LIMIT=128
SANDBOX_CONTAINER_TIMEOUT_MS=30000
SANDBOX_CONTAINER_MAX_OUTPUT_BYTES=65536
